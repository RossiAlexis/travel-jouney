// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String? // Optional for OAuth-only users
  username     String   @unique
  displayName  String
  avatar       String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  accounts Account[]
  sessions Session[]
  trips    Trip[]
  memories Memory[]
  expenses Expense[]

  @@index([email])
  @@index([username])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String // "credentials" | "google"
  providerAccountId String // External provider's user ID
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

// ============================================
// TRIP
// ============================================

model Trip {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?
  coverImage  String?
  startDate   DateTime
  endDate     DateTime?
  status      TripStatus @default(PLANNED)
  isPublic    Boolean    @default(false)
  slug        String?
  budget      Float?
  currency    String     @default("USD")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  memories Memory[]
  expenses Expense[]

  @@unique([userId, slug])
  @@index([userId])
  @@index([status])
  @@index([isPublic])
}

enum TripStatus {
  PLANNED
  ONGOING
  COMPLETED
}

// ============================================
// MEMORY (Travel Memory / Journal Entry)
// ============================================

model Memory {
  id              String         @id @default(cuid())
  tripId          String
  userId          String
  title           String
  content         String
  date            DateTime
  locationName    String?
  locationAddress String?
  latitude        Float?
  longitude       Float?
  placeId         String?
  category        MemoryCategory @default(OTHER)
  rating          Int? // 1-5 stars
  isPublic        Boolean        @default(false)
  slug            String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  trip     Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos   Photo[]
  expenses Expense[]

  @@unique([tripId, slug])
  @@index([tripId])
  @@index([userId])
  @@index([date])
  @@index([category])
}

enum MemoryCategory {
  ACCOMMODATION
  FOOD
  ACTIVITY
  TRANSPORT
  REFLECTION
  OTHER
}

// ============================================
// PHOTO
// ============================================

model Photo {
  id        String   @id @default(cuid())
  memoryId  String
  url       String
  thumbnail String?
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
}

// ============================================
// EXPENSE
// ============================================

model Expense {
  id          String          @id @default(cuid())
  tripId      String
  userId      String
  memoryId    String? // Optional link to related memory
  amount      Float // Store in original currency
  currency    String
  category    ExpenseCategory
  description String
  date        DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  trip   Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  memory Memory? @relation(fields: [memoryId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([userId])
  @@index([date])
}

enum ExpenseCategory {
  ACCOMMODATION
  FOOD
  TRANSPORT
  ACTIVITIES
  SHOPPING
  OTHER
}
